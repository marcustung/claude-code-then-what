+check('Python ≥ 3.8', sys.version_info >= (3, 8), f'目前 {sys.version.split()[0]}，請安裝 Python 3.8 以上')
+for f in REQUIRED:
+    check(f'檔案 {f}', (skill / f).exists(), f'缺 {f}：請重新複製整個 .claude/skills/trace-notification 資料夾，不要只複製 SKILL.md')
