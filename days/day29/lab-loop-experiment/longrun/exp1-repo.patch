+        shutil.rmtree(tmp, ignore_errors=True)
+
+failed = [n for n, ok, _ in rows if not ok]
+print(f'\n{len(rows) - len(failed)}/{len(rows)} PASS')
+sys.exit(1 if failed else 0)
