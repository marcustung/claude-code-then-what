+Check("SC-07", "已取消再次取消不重複退款（已付款）", () =>
+{
+    var o = new Order(Shipped: false, Paid: true, Cancelled: true);
+    var r = Cancellation.Cancel(o);
+    return r.Order == o && !r.RefundRequested;
+});
+
