{
  "uid": "day25-before-pretty",
  "title": "通知送出監控（常見做法，作者建立的對照）",
  "tags": [
    "day25",
    "before"
  ],
  "time": {
    "from": "now-1m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "通知送出成功率",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (run, scenario) (last_over_time(work_stage_count{job=\"day25-work-view\",stage_order=\"3\"}[$__range])) / max by (run, scenario) (last_over_time(work_stage_count{job=\"day25-work-view\",stage_order=\"1\"}[$__range]))",
          "legendFormat": "{{scenario}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "系統回報已送出（則）",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (run) (last_over_time(work_stage_count{job=\"day25-work-view\",stage_order=\"3\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "取消成功（筆）",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (run) (last_over_time(work_stage_count{job=\"day25-work-view\",stage_order=\"1\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    }
  ]
}