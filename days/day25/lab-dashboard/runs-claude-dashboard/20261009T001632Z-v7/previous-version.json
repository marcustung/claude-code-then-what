        ],
        "fieldConfig": {
          "defaults": { "noValue": "? 無資料", "color": { "mode": "thresholds" },
            "mappings": [ { "type": "value", "options": {
              "1": { "text": "✗ 沒處理完", "color": "red", "index": 0 },
              "2": { "text": "? 紀錄不全", "color": "#808080", "index": 1 },
