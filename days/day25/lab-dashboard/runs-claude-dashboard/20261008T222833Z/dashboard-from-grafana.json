      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run, scenario) (last_over_time(work_expected{job=\"day25-work-view\", run=~\"$run\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run) (last_over_time(work_matched{job=\"day25-work-view\", run=~\"$run\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (run) (last_over_time(work_matched{job=\"day25-work-view\", run=~\"$run\"}[$__range])) / (max by (run) (last_over_time(work_expected{job=\"day25-work-view\", run=~\"$run\"}[$__range])) > 0)) and on (run) max by (run) (last_over_time(work_status{job=\"day25-work-view\", run=~\"$run\", status!=\"unknown\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run, status, reason) (last_over_time(work_status{job=\"day25-work-view\", run=~\"$run\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run) (last_over_time(work_unmatched{job=\"day25-work-view\", run=~\"$run\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        }
      ],
      "title": "各輪對帳：應完成 / 已確認 / 完成率 / 狀態",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "run",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
