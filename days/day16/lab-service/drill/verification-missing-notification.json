 "sink_says": {
  "unique_receipts": 3,
  "reading": "接收端只有三則收據。六張已取消的訂單，對方不知道。"
 },
 "root_cause": {
  "file": "src/Api/Program.cs",
  "version": "1.0.0",
  "lines": "146–150（git 71e57b8）",
  "code": "if (_f.DropOverQueue is int q && _ch.Reader.Count > q) { /* 故障：假裝送了 */ _m.Inc(\"notify_sent_total\"); _log.Write(... event = \"notify_deferred\" ...); continue; }",
  "why_invisible": [
   "notify_sent_total 在「丟掉」的那一條路徑上被加一——計數器記的是「我決定不送」，不是「對方收到」。",
   "continue 之後沒有重新入列，所以佇列深度一路降到 0，看起來像排空，其實是丟完了。",
   "唯一的痕跡是 notify_deferred，級別 INFO——和正常訊息混在一起，不會觸發任何告警。",
   "沒有進 dead_letter，所以 NC-05 的「不得安靜丟失」在指標上看不出被違反。"
  ]
 },
 "why_the_last_three_survived": "判斷式用的是 _ch.Reader.Count，也就是「取出這一則之後還剩幾則」，不是入列當下的深度。九則入列後，worker 每取一則就看剩餘量：剩 7、7、6、5、4、3 時都 > 2，全部丟掉；剩 2 以下才走正常送出。所以存活的必然是最後三則（r013／r014／r015），而不是最早的三則——這一點光看指標永遠推不出來，要逐筆對 queue_depth 才看得到。",
 "contract_violations": [
  "NC-01（每次轉換恰好一則通知）",
  "NC-04（送達以接收端收據為準）",
  "NC-05（不得安靜丟失）"
 ],
 "fixed_in": {
  "version": "1.1.0",
