    "orders": 600,
    "concurrency": 32,
    "payload_bytes": 65536,
    "repeat": 4,
    "seed": 7
  },
  "expected": {
    "p95_ms_max": 250,
    "heap_growth_mb_max": 64
  },
  "wait": {
    "timeout_seconds": 180
  }
}
