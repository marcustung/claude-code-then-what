{
  "scenario": "load-baseline",
  "mode": "load",
  "description": "壓力對照：600 張訂單、每張取消 4 次（後 3 次為重複取消）、併發 32、每筆 64 KB 附註；無注入；服務要活著、p95 ≤ 250 ms、heap 成長 ≤ 64 MB、通知對帳成立",
  "faults": null,
  "env": {
    "DOTNET_GCHeapHardLimit": "0x8000000"
