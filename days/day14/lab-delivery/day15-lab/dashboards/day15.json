{
  "uid": "day15-readiness",
  "title": "Day15 | Pre-production load evidence (local teaching)",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate / second",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (testid) (rate(k6_http_reqs_total[10s]))",
          "legendFormat": "{{testid}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "First cancel p95 / scenario (running aggregate)",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_cancel_ms_p95 * 1000",
          "legendFormat": "{{testid}} {{scenario}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP failure rate (worst labelled series)",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (k6_http_req_failed_rate)",
          "legendFormat": "{{testid}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Working set / GC heap",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oc_working_set_bytes",
          "legendFormat": "oc_working_set_bytes"
        },
        {
          "refId": "B",
          "expr": "oc_gc_heap_bytes",
          "legendFormat": "oc_gc_heap_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notification queue",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oc_notify_queue_depth",
          "legendFormat": "{{testid}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Enqueued / sent counters",
      "datasource": {
        "type": "prometheus",
        "uid": "day15-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oc_notify_enqueued_total",
          "legendFormat": "oc_notify_enqueued_total"
        },
        {
          "refId": "B",
          "expr": "oc_notify_sent_total",
          "legendFormat": "oc_notify_sent_total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "tags": [
    "day15",
    "local-teaching"
  ],
  "description": "Same Day14 package; local load only, no Production approval. p95 is exported running aggregate, not rolling-window p95. CPU is not collected."
}